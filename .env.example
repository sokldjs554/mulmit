# Copy to .env and fill in what you need. Every variable is optional for the offline demo;
# unset keys fall back to the heuristic extractor / hashing embedder / fake payments / fixtures.
# Full list: apps/api/src/mulmit/settings.py (prefix MULMIT_).

# --- LLM (Claude) ---------------------------------------------------------------------
MULMIT_LLM_PROVIDER=heuristic            # anthropic | heuristic
MULMIT_ANTHROPIC_API_KEY=
MULMIT_LLM_EXTRACT_MODEL=claude-opus-5
MULMIT_LLM_EXTRACT_EFFORT=low
MULMIT_LLM_BRIEF_EFFORT=medium
MULMIT_LLM_DAILY_BUDGET_USD=25

# --- embeddings -----------------------------------------------------------------------
MULMIT_EMBEDDING_PROVIDER=hashing        # voyage | hashing
MULMIT_VOYAGE_API_KEY=

# --- public data sources (issue keys at each portal) -----------------------------------
MULMIT_CLIK_API_KEY=                     # 국회도서관 지방의정포털 Open API
MULMIT_DATA_GO_KR_SERVICE_KEY=           # 공공데이터포털 (조달청 나라장터 발주계획·사전규격·입찰공고)
MULMIT_LOFIN_API_KEY=                    # 지방재정365

# --- billing (Toss Payments 자동결제) ---------------------------------------------------
MULMIT_PAYMENT_PROVIDER=fake             # toss | fake
MULMIT_TOSS_CLIENT_KEY=
MULMIT_TOSS_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MULMIT_BILLING_KEY_ENCRYPTION_KEY=

# --- notifications --------------------------------------------------------------------
MULMIT_SMTP_HOST=localhost
MULMIT_SMTP_PORT=1025
MULMIT_SOLAPI_API_KEY=                   # 카카오 알림톡 (Solapi)
MULMIT_SOLAPI_API_SECRET=
MULMIT_KAKAO_PF_ID=
MULMIT_KAKAO_TEMPLATE_ID=
MULMIT_KAKAO_SENDER_NUMBER=

# --- security & observability -----------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MULMIT_JWT_SECRET=
MULMIT_SENTRY_DSN=
